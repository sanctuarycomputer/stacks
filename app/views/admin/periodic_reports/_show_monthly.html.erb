<% blueprint = periodic_report.blueprint || {} %>
<% mso_trueups = periodic_report.mso_trueups_if_ready.includes(ledger: { contributor: :forecast_person }).order(:id).to_a %>

<%= render "okrs", periodic_report: periodic_report, scope_param: scope_param, scope_studio: scope_studio,
                   studio_tabs: studio_tabs, collective_okrs: collective_okrs %>

<div class="title_bar" id="title_bar" style="padding: 80px 0px 20px 0px;">
  <div id="titlebar_left">
    <h2 id="page_title">MSO compensation</h2>
  </div>
</div>

<% if periodic_report.notification.present? %>
  <div class="dashboard-modules table index_table index">
    <div class="dashboard-module">
      <div class="module-body factoid-parent">
        <p>The last sync of this month's MSO true-ups did not finish:</p>
        <p><code><%= periodic_report.notification.params[:exception][:message] %></code></p>
        <%= link_to "Inspect Error ↗", admin_notification_path(periodic_report.notification) %>
      </div>
    </div>
  </div>
<% end %>

<% if blueprint["out_of_sync"] && periodic_report.mso_trueups_if_ready.any? %>
  <div class="flash flash_alert" style="margin-bottom: 1em;">The MSO payments are out of sync with the actual earnings for the MSO that month.</div>
<% end %>

<% if blueprint["fee_income"].present? %>
  <% [
    ["fee_income", "Management fee income (account 4100)"],
    ["cap", "Cap (#{(blueprint["cap_percentage"].to_f * 100).round(2)}% of fee income)"],
    ["benchmark_average", "Benchmark (top #{blueprint["counted"]} of #{blueprint["configured_n"]})"],
    ["total_trueup", "Total true-ups"],
  ].each_slice(2) do |row| %>
    <div class="dashboard-modules table index_table index">
      <% row.each do |key, label| %>
        <div class="dashboard-module">
          <div class="module-body factoid-parent">
            <div class="factoid">
              <h2><%= number_to_currency(blueprint[key]) %></h2>
              <p><%= label %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if mso_trueups.any? %>
  <table border="0" cellspacing="0" cellpadding="0" class="index_table index">
    <thead>
      <tr>
        <th class="col">Contributor</th>
        <th class="col">Tier</th>
        <th class="col">Calculated</th>
        <th class="col">After cap</th>
        <th class="col">Already earned</th>
        <th class="col">True-up</th>
        <th class="col">Accepted?</th>
        <th class="col"></th>
      </tr>
    </thead>
    <tbody>
      <% mso_trueups.each_with_index do |mso_trueup, index| %>
        <tr class="<%= index.even? ? "even" : "odd" %>">
          <td class="col"><%= link_to mso_trueup.contributor.forecast_person.email, admin_contributor_path(mso_trueup.contributor, ledger: mso_trueup.ledger_id) %></td>
          <td class="col"><%= mso_trueup.blueprint["tier"].to_s.titleize %> (<%= mso_trueup.blueprint["multiplier"] %>x)</td>
          <td class="col"><%= number_to_currency(mso_trueup.blueprint["calculated"]) %></td>
          <td class="col"><%= number_to_currency(mso_trueup.blueprint["final"]) %></td>
          <td class="col"><%= number_to_currency(mso_trueup.blueprint["already_earned"]) %></td>
          <td class="col"><%= number_to_currency(mso_trueup.amount) %></td>
          <td class="col">
            <span class="pill <%= mso_trueup.accepted? ? "accepted" : "pending" %>">
              <%= mso_trueup.accepted? ? "Accepted" : "Pending" %>
            </span>
          </td>
          <td class="col"><%= link_to "Info ↗", admin_ledger_mso_trueup_path(mso_trueup.ledger, mso_trueup) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif periodic_report.notification.blank? %>
  <div class="dashboard-modules table index_table index">
    <div class="dashboard-module">
      <div class="module-body factoid-parent">
        <p>No MSO true-ups for this month<%= blueprint["fee_income"].present? ? "." : " yet. An admin syncs them from this page." %></p>
      </div>
    </div>
  </div>
<% end %>
